        # Left column
        IFS='|' read -r ver name year <<< "${MACOS_VERSIONS[$i]}"
        printf "  ${CYAN}%2d${NC})  %-8s  %-16s  %s" "$((i+2))" "$ver" "$name" "$year"
        
