if [ ${#ARGS[@]} -eq 0 ]; then
    if [ -p /dev/stdin ] || [ ! -t 0 ]; then
        clear
        log_error "Interactive mode unavailable when piped"
        exit 1
    fi
    run_interactive_menu
fi

main
